{
  "manifest_version": 3,
  "name": "LocalPassMass",
  "short_name": "LocalPassMass",
  "version": "1.10.4",
  "description": "LocalPassMass — پس مس لوکال | مدیر رمز عبور محلی و آفلاین برای Chrome",
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "activeTab"
  ],
  "optional_permissions": [
    "scripting",
    "nativeMessaging",
    "offscreen",
    "clipboardWrite",
    "favicon"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LocalPassMass — پس مس لوکال",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  },
  "commands": {
    "lock-vault": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "قفل فوری LocalPassMass"
    }
  },
  "minimum_chrome_version": "127"
}
